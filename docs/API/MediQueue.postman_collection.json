    },
    {
      "name": "Admin history get session token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "const m=pm.response.text().match(/name=\"csrf_token\"[^>]*value=\"([^\"]+)/); if(m) pm.collectionVariables.set('csrf',m[1]);"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify cancelled history retained",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/appointments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test('Cancelled record is retained',()=>pm.expect(pm.response.json().appointments.some(a=>String(a.id)===String(pm.collectionVariables.get('appointment_id'))&&a.status==='Cancelled')).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "Export CSV",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/reports/appointments.csv"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "Deactivate disposable doctor",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf}}"
          }
        ],
        "url": "{{base_url}}/api/admin/doctors/{{doctor_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"active\": false}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              ""
            ]
          }
        }
      ]
    }
  ]
}